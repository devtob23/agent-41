# Agent "aider" for ollama-box. Uses the selected Ollama model.
# Usage: ollama-box --agent aider
# ollama-box sets SHELL_IMAGE to match --with.
ARG SHELL_IMAGE=localhost/ollama-agent-shell:latest
FROM ${SHELL_IMAGE}

USER root
RUN python3 -m venv /opt/aider \
    && /opt/aider/bin/pip install --no-cache-dir aider-chat

# Offline operation: no update check, no analytics.
# Git: no automatic commits, no attribution to aider as author or co-author.
ENV AIDER_CHECK_UPDATE=false \
    AIDER_ANALYTICS_DISABLE=true \
    AIDER_AUTO_COMMITS=false \
    AIDER_ATTRIBUTE_AUTHOR=false \
    AIDER_ATTRIBUTE_COMMITTER=false \
    AIDER_ATTRIBUTE_CO_AUTHORED_BY=false \
    AIDER_GITIGNORE=false

# Hand the home directory to the agent user (1000). At runtime ollama-box creates a fresh
# /home/agent and Podman copies the image contents into it, including ownership.
RUN rm -rf /home/agent/.npm /home/agent/.cache \
    && mkdir -p /home/agent \
    && chown -R 1000:1000 /home/agent

# Model comes from $OLLAMA_MODEL, Ollama from $OLLAMA_API_BASE (set by ollama-box).
# Otherwise Aider sets the Ollama context window itself for every request. With
# OLLAMA_CONTEXT_LENGTH it is fixed instead (settings file for this model).
ENTRYPOINT ["sh", "-c", "if [ -n \"${OLLAMA_CONTEXT_LENGTH:-}\" ]; then printf -- \"- name: ollama_chat/%s\\n  extra_params:\\n    num_ctx: %s\\n\" \"$OLLAMA_MODEL\" \"$OLLAMA_CONTEXT_LENGTH\" > /tmp/aider-model-settings.yml; set -- --model-settings-file /tmp/aider-model-settings.yml \"$@\"; fi; exec /opt/aider/bin/aider --model \"ollama_chat/${OLLAMA_MODEL}\" \"$@\"", "aider"]
