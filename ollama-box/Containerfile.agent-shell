# Base for all ollama-box agents: Bash, Git, Python, curl.
# Starts a shell. Ollama is reachable at $OLLAMA_HOST, the model is in $OLLAMA_MODEL.
# Test inside the container:  curl -s $OLLAMA_HOST/api/tags
FROM docker.io/library/node:22-bookworm-slim

# TypeScript tooling for all agents.
RUN npm install -g typescript

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl wget ca-certificates ripgrep less procps unzip zip jq \
      python3 python3-pip python3-venv \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

# Optional toolchains, selected with --with (comma-separated; empty = none).
ARG TOOLCHAINS=""
RUN set -eu; pkgs=""; \
    for t in $(echo "$TOOLCHAINS" | tr ',' ' '); do \
      case "$t" in \
        cpp)  pkgs="$pkgs cmake ninja-build pkg-config gdb" ;; \
        go)   pkgs="$pkgs golang-go" ;; \
        java) pkgs="$pkgs default-jdk maven" ;; \
        lua)  pkgs="$pkgs lua5.4" ;; \
        perl) pkgs="$pkgs perl" ;; \
        php)  pkgs="$pkgs php-cli php-mbstring php-xml composer" ;; \
        ruby) pkgs="$pkgs ruby ruby-dev bundler" ;; \
        rust) pkgs="$pkgs rustc cargo" ;; \
        *) echo "Unknown toolchain: $t" >&2; exit 1 ;; \
      esac; \
    done; \
    if [ -n "$pkgs" ]; then \
      apt-get update && apt-get install -y --no-install-recommends $pkgs \
      && rm -rf /var/lib/apt/lists/*; \
    fi

RUN mkdir -p /work /home/agent && chmod 1777 /home/agent
ENV HOME=/home/agent
WORKDIR /work
ENTRYPOINT ["bash"]
