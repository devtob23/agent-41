#!/usr/bin/env bash
# ollama-box: starts a coding agent with a local Ollama model in Podman.
# Ollama stays internal; agent tools get internet only after per-model approval.
# Help: ollama-box --help
set -euo pipefail
BOX_VERSION="0.3.0"
BOX_NAME="ollama-box"
CONFIGURE=0
ROOT_VARIABLE="OLLAMA_BOX_ROOT"

# ============================================================
# SETTING: folder where your projects live.
# Set it with the OLLAMA_BOX_ROOT environment variable, e.g. in ~/.profile.
# ollama-box only starts directly inside a project in it,
# i.e. in <PROJECTS_ROOT>/<project>, not deeper and not higher.
# ============================================================
PROJECTS_ROOT="${OLLAMA_BOX_ROOT:-}"

CONF_DIR="${OLLAMA_BOX_DIR:-$HOME/.config/ollama-box}"
GPU_FILE="${CONF_DIR}/gpu"
OLLAMA_IMAGE="${OLLAMA_BOX_OLLAMA_IMAGE:-docker.io/ollama/ollama:latest}"
OLLAMA_VOLUME="ollama-box-models"
OLLAMA_CONTAINER="ollama-box-ollama-<session>"
NETWORK_NAME="ollama-box-net-<session>"
AGENT_OWNED=0
NETWORK_OWNED=0
CONTAINER_OWNED=0
MAX_MODELS=50
# Default context window in tokens (Claude Code gets 65536).
DEFAULT_CONTEXT=32768
MAX_ARGS=20

die() {
  echo "ollama-box: $*" >&2
  exit 1
}

# Plain data, never sourced as shell code. Environment overrides the saved path.
configure_projects() {
  local saved="${CONF_DIR}/projects-root" candidate answer
  candidate="$PROJECTS_ROOT"
  if [ "$CONFIGURE" = 0 ] && [ -f "$saved" ]; then
    if [ -z "$candidate" ]; then IFS= read -r candidate < "$saved" || true; fi
  elif [ -t 0 ]; then
    candidate="${candidate:-$HOME/yourProjectPath}"
    while true; do
      read -e -r -p "Projects root [${candidate}] (Tab completes paths): " answer || die "Setup aborted."
      candidate="${answer:-$candidate}"
      case "$candidate" in '~') candidate="$HOME" ;; '~/'*) candidate="$HOME/${candidate#\~/}" ;; esac
      if [ ! -d "$candidate" ]; then echo "Folder does not exist. Please try again." >&2; continue; fi
      candidate="$(cd "$candidate" && pwd -P)"
      if [ "$candidate" = / ] || [ "$candidate" = "$(cd "$HOME" && pwd -P)" ]; then
        echo "Please choose a dedicated projects root, not / or HOME." >&2; continue
      fi
      read -r -p "Save ${ROOT_VARIABLE}=${candidate}? [y/N]: " answer || die "Setup aborted."
      case "$answer" in y|Y|yes|Yes|YES) break ;; *) echo "Please edit the path." >&2 ;; esac
    done
    mkdir -p "$CONF_DIR"
    (umask 077; printf '%s\n' "$candidate" > "$saved")
  elif [ -z "$candidate" ]; then
    die "First start needs a terminal; alternatively set ${ROOT_VARIABLE}."
  fi
  [ -d "$candidate" ] || die "Projects root '${candidate}' does not exist. Use --configure to change it."
  PROJECTS_ROOT="$(cd "$candidate" && pwd -P)"
  export "${ROOT_VARIABLE}=${PROJECTS_ROOT}"
}

# Podman -v uses colons as field separators; reject ambiguous host paths.
validate_project_path() {
  case "$1" in
    *:*|*,*) die "Project path must not contain a colon or comma." ;;
  esac
}

show_version() {
  printf '%s %s\nScript: %s\nConfiguration: %s\n' "$BOX_NAME" "$BOX_VERSION" "$0" "$CONF_DIR"
}

# --- Platform: Linux, macOS (Podman machine) or Windows via WSL2 ---
detect_platform() {
  case "$(uname -s)" in
    Linux)
      if grep -qi microsoft /proc/version 2>/dev/null; then
        PLATFORM="wsl"
      else
        PLATFORM="linux"
      fi ;;
    Darwin) PLATFORM="macos" ;;
    MINGW*|MSYS*|CYGWIN*) PLATFORM="windows" ;;
    *) PLATFORM="unknown" ;;
  esac
}

# Checks whether Podman is installed, recent enough and reachable.
check_podman() {
  [ "$PLATFORM" != "windows" ] \
    || die "On Windows, please start in WSL2. For the Command Prompt there is windows/ollama-box.cmd (see README)."
  command -v podman >/dev/null 2>&1 || die "podman is not installed. See README, section Requirements."
  [ "$(id -u)" != "0" ] || die "Do not run as root; rootless Podman is required."
  local version major minor rest rootless
  version="$(podman --version 2>/dev/null | awk '{print $NF}')"
  major="${version%%.*}"
  rest="${version#*.}"
  minor="${rest%%.*}"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || die "Could not determine the Podman version."
  if [ "$major" -lt 4 ] || { [ "$major" -eq 4 ] && [ "$minor" -lt 4 ]; }; then
    die "Podman ${version} is too old; version 4.4 or later is required."
  fi
  if ! podman info >/dev/null 2>&1; then
    [ "$PLATFORM" != "macos" ] || die "Podman is not responding. Is the Podman machine running? Start it with: podman machine start"
    die "Podman is not responding (podman info fails)."
  fi
  rootless="$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" \
    || die "Could not determine whether Podman runs rootless."
  [ "$rootless" = true ] || die "Podman must run rootless, also over a remote connection."
  case "$PLATFORM" in
    macos|wsl) echo "ollama-box: Note: macOS and Windows/WSL2 are experimental and not tested in practice." >&2 ;;
  esac
  [ "$PLATFORM" != "unknown" ] || echo "ollama-box: Warning: unknown operating system '$(uname -s)', treating it as Linux." >&2
}

# Network options for pasta. Newer pasta versions can disable access to the host.
# Older ones don't know these options; then plain pasta without extra options is used.
pasta_opts() {
  local full="pasta:--map-guest-addr,none,--map-host-loopback,none"
  if [ "$PLATFORM" = "macos" ]; then
    echo "$full"
    return 0
  fi
  if command -v pasta >/dev/null 2>&1 && pasta --help 2>&1 | grep -q -- '--map-guest-addr'; then
    echo "$full"
    return 0
  fi
  echo "ollama-box: Note: older pasta version, the extra options that block host access are skipped." >&2
  echo "pasta"
}

# Appends a pasta option to existing network options.
add_pasta_opt() {
  local opts="$1"
  local extra="$2"
  [ -n "$extra" ] || die "internal error: no pasta option."
  case "$opts" in
    *:*) echo "${opts},${extra}" ;;
    *) echo "${opts}:${extra}" ;;
  esac
}

